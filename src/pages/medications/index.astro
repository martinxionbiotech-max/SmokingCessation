---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import Sources from '~/components/common/Sources.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { SITE } from 'astrowind:config';
import CallToAction from '~/components/widgets/CallToAction.astro';

const medications = (await getCollection('method')).filter((m) => m.data.medicationWarning);

const metadata = {
  title: 'Quit Smoking Medications | Quit Smoking Hub',
  description:
    'Evidence pages for smoking cessation medications: nicotine replacement therapy, varenicline, bupropion and cytisine. What they are, how they work, and what trials found.',
};

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  headline: 'Quit Smoking Medications | Quit Smoking Hub',
  name: 'Quit Smoking Medications | Quit Smoking Hub',
  description: 'Evidence pages for smoking cessation medications: nicotine replacement therapy, varenicline, bupropion and cytisine. What they are, how they work, and what trials found.',
  url: `${String(SITE.site).replace(/\/$/, '')}/medications/`,
  mainEntityOfPage: `${String(SITE.site).replace(/\/$/, '')}/medications/`,
  isPartOf: { '@id': `${SITE.site}/#website` },
  author: { '@type': 'Organization', name: 'SmokingCessationHub Tech Team' },
  reviewedBy: { '@type': 'Organization', name: 'SmokingCessationHub Tech Team' },
  publisher: { '@id': `${SITE.site}/#organization` },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.site },
    { '@type': 'ListItem', position: 2, name: 'Medications', item: SITE.site + '/medications/' },
    { '@type': 'ListItem', position: 3, name: 'Quit smoking medications: the evidence' },
  ],
};

const pageSources = [
    { label: 'NICE NG209 — Tobacco: preventing uptake, promoting quitting and treating dependence', url: 'https://www.nice.org.uk/guidance/ng209' },
    { label: 'USPSTF — Tobacco Smoking Cessation in Adults, Including Pregnant Persons', url: 'https://www.uspreventiveservicestaskforce.org/uspstf/recommendation/tobacco-use-in-adults-and-pregnant-women-counseling-and-interventions' },
    { label: 'Cochrane — Pharmacological interventions for smoking cessation (overview & network meta-analysis)', url: 'https://doi.org/10.1002/14651858.CD009329.pub2' },
];

---



<Layout metadata={metadata}>
  <StructuredData slot="head" schema={[pageSchema, breadcrumbSchema]} />
  <Breadcrumbs bar items={[{ text: 'Home', href: '/' }, { text: 'Medications', href: '/medications/' }, { text: 'Quit smoking medications: the evidence' }]} />
  <section class="relative mx-auto max-w-4xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2 text-center">Quit Smoking Medications</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading text-center">
      Quit smoking medications: the evidence
    </h1>
    <p class="mt-4 max-w-3xl mx-auto text-lg text-muted text-center">
      Medication is one of the strongest tools available for quitting — combined with behavioral support it is more
      effective than either alone. These pages explain the evidence. They do not prescribe.
    </p>
  </section>
  <p class="mx-auto max-w-4xl px-4 sm:px-6 pb-2 text-xs text-muted dark:text-slate-400">Maintained by <span class="font-semibold">SmokingCessationHub Tech Team</span></p>

  <section class="mx-auto max-w-4xl px-4 sm:px-6 py-8">
    <div class="grid gap-6 md:grid-cols-2">
      {
        medications.map((m) => (
          <a
            href={`/medications/${m.data.slug}/`}
            class="card p-6 no-underline hover:-translate-y-1 transition duration-200"
          >
            <h2 class="font-bold font-heading text-xl mb-2">{m.data.title}</h2>
            <p class="text-muted dark:text-slate-400 text-sm mb-3">{m.data.summary}</p>
            <p class="text-sm">
              Evidence strength: <span class="font-bold text-primary">{m.data.evidenceStrength}</span>
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 sm:px-6 py-8 space-y-6">
    <div class="card p-8">
      <h2 class="text-2xl font-bold font-heading mb-3">How medication helps</h2>
      <p class="text-muted dark:text-slate-400 mb-3">
        Nicotine withdrawal is the main reason early quit attempts fail. Medications act on the brain's nicotine
        system to reduce withdrawal and craving, which frees up attention for the behavioral work — new routines,
        trigger management, coping skills. This is why trials consistently find that medication plus behavioral
        support outperforms either alone.
      </p>
    </div>

    <div class="card p-8 border-l-4 border-l-primary">
      <h2 class="text-2xl font-bold font-heading mb-3">Important: this is information, not a prescription</h2>
      <ul class="list-disc list-inside space-y-2 text-muted dark:text-slate-400 text-sm">
        <li>We do not recommend doses, judge whether a medication suits you, or give individual advice.</li>
        <li>Prescription medications (varenicline, bupropion, cytisine in most countries) require a healthcare professional.</li>
        <li>Every medication has contraindications, interactions and side effects that only a prescriber can assess.</li>
        <li>Pregnant people, people with cardiovascular disease, mental health conditions or other illnesses need professional guidance.</li>
      </ul>
      <p class="text-sm font-bold text-heading mt-3">
        Questions to ask a healthcare professional are listed on each medication page.
      </p>
      <p class="text-sm text-muted dark:text-slate-500 mt-3">
        Per-medication evidence — trials, systematic reviews, safety data and how guidelines position each option — is
        collected in the{' '}
        <a
          href="https://data.smokingcessationhub.com/medications/"
          target="_blank"
          class="text-primary underline decoration-1 underline-offset-2"
        >
          Data Center medication evidence pages
        </a>.
      </p>
    </div>
  </section>

  <Sources sources={pageSources} />
  <CallToAction
    title="Medication + support = strongest evidence"
    subtitle="Read the method pages to see how medication combines with counseling, quitlines and community support."
    actions={[{ variant: 'primary', text: 'Compare Quit Methods', href: '/methods/' }]}
  />
</Layout>
