---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import Sources from '~/components/common/Sources.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { SITE } from 'astrowind:config';
import CallToAction from '~/components/widgets/CallToAction.astro';

const comparisons = (await getCollection('comparison')).sort((a, b) => a.data.title.localeCompare(b.data.title));

const metadata = {
  title: 'Quit Methods Compared Head-to-Head | Quit Smoking Hub',
  description:
    'Head-to-head comparisons of the big quitting decisions: cold turkey vs gradual reduction, NRT vs no medication, medication vs behavioral support and combination vs single-form NRT.',
};

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  headline: 'Quit Methods Compared Head-to-Head | Quit Smoking Hub',
  name: 'Quit Methods Compared Head-to-Head | Quit Smoking Hub',
  description: 'Head-to-head comparisons of the big quitting decisions: cold turkey vs gradual reduction, NRT vs no medication, medication vs behavioral support and combination vs single-form NRT.',
  url: `${String(SITE.site).replace(/\/$/, '')}/comparisons/`,
  mainEntityOfPage: `${String(SITE.site).replace(/\/$/, '')}/comparisons/`,
  isPartOf: { '@id': `${SITE.site}/#website` },
  author: { '@type': 'Organization', name: 'SmokingCessationHub Tech Team' },
  reviewedBy: { '@type': 'Organization', name: 'SmokingCessationHub Tech Team' },
  publisher: { '@id': `${SITE.site}/#organization` },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.site },
    { '@type': 'ListItem', position: 2, name: 'Comparisons', item: SITE.site + '/comparisons/' },
    { '@type': 'ListItem', position: 3, name: 'Quit methods compared' },
  ],
};

const pageSources = [
    { label: 'Cochrane — Pharmacological interventions for smoking cessation (overview & network meta-analysis)', url: 'https://doi.org/10.1002/14651858.CD009329.pub2' },
    { label: 'NICE NG209 — Tobacco: preventing uptake, promoting quitting and treating dependence', url: 'https://www.nice.org.uk/guidance/ng209' },
];

---



<Layout metadata={metadata}>
  <StructuredData slot="head" schema={[pageSchema, breadcrumbSchema]} />
  <Breadcrumbs bar items={[{ text: 'Home', href: '/' }, { text: 'Comparisons', href: '/comparisons/' }, { text: 'Quit methods compared' }]} />
  <section class="relative mx-auto max-w-4xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2 text-center">Head-to-Head</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading text-center">
      Quit methods compared
    </h1>
    <p class="mt-4 max-w-3xl mx-auto text-lg text-muted text-center">
      The decisions every quitter faces, examined side by side with the best available evidence. No single method wins
      for everyone — the goal is matching the approach to you.
    </p>
  </section>
  <p class="mx-auto max-w-4xl px-4 sm:px-6 pb-2 text-xs text-muted dark:text-slate-400">Maintained by <span class="font-semibold">SmokingCessationHub Tech Team</span></p>

  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-8 space-y-6">
    {
      comparisons.map((c) => (
        <a
          href={`/comparisons/${c.data.slug}/`}
          class="card p-6 block no-underline hover:-translate-y-1 transition duration-200"
        >
          <h2 class="font-bold font-heading text-xl mb-1">{c.data.title}</h2>
          <p class="text-sm text-muted dark:text-slate-400 mb-3">
            <span class="font-semibold text-heading">{c.data.optionA}</span> vs <span class="font-semibold text-heading">{c.data.optionB}</span>
          </p>
          <p class="text-muted dark:text-slate-400 text-sm">{c.data.summary}</p>
          <p class="text-sm mt-3">
            Evidence strength: <span class="font-bold text-primary">{c.data.evidenceStrength}</span>
          </p>
        </a>
      ))
    }
  </section>

  <Sources sources={pageSources} />
  <CallToAction
    title="Not sure which method fits you?"
    subtitle="Browse every quit method with its evidence strength."
    actions={[
      { variant: 'primary', text: 'All Quit Methods', href: '/methods/' },
      { text: 'Popular Questions', href: '/questions/' },
    ]}
  />
</Layout>
