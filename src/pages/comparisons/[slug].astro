---
import { getCollection, render } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import Sources from '~/components/common/Sources.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import ReviewStatement from '~/components/common/ReviewStatement.astro';
import { SITE } from 'astrowind:config';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { seoDescription, seoTitle } from '~/utils/seo';
import { authorRef, dateFields, organizationRef, siteUrl } from '~/utils/schema';

export async function getStaticPaths() {
  const comparisons = await getCollection('comparison');
  return comparisons.map((c) => ({ params: { slug: c.data.slug }, props: { comparison: c } }));
}

const { comparison } = Astro.props;
const { Content } = await render(comparison);
const c = comparison.data;

const site = siteUrl(SITE.site);

// Comparisons written after N9 carry a long-form markdown body and their own
// tables. Older records have frontmatter only, so they keep the compact
// structured layout (evidence block, side-by-side cards, who-might-prefer).
const hasBody = Boolean(comparison.body?.trim());

const metadata = {
  title: seoTitle(`${c.title} | Quit Smoking Hub`),
  description: seoDescription(c.summary),
};

const url = `${site}/comparisons/${c.slug}/`;

const pageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: c.title,
    description: c.summary,
    url,
    mainEntityOfPage: url,
    isPartOf: { '@id': `${site}/#website` },
    author: authorRef(SITE.site),
    publisher: organizationRef(SITE.site),
    ...dateFields(undefined, c.lastReviewed),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalWebPage',
    headline: c.title,
    name: c.title,
    description: c.summary,
    url,
    mainEntityOfPage: url,
    isPartOf: { '@id': `${site}/#website` },
    author: authorRef(SITE.site),
    publisher: organizationRef(SITE.site),
    about: { '@type': 'MedicalTherapy', name: `${c.optionA} versus ${c.optionB}` },
    ...dateFields(undefined, c.lastReviewed),
  },
];

const pageSources = c.sourceLinks?.length
  ? c.sourceLinks
  : [
      {
        label: 'Cochrane — Pharmacological interventions for smoking cessation (overview & network meta-analysis)',
        url: 'https://doi.org/10.1002/14651858.CD009329.pub2',
      },
      {
        label: 'NICE NG209 — Tobacco: preventing uptake, promoting quitting and treating dependence',
        url: 'https://www.nice.org.uk/guidance/ng209',
      },
    ];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={pageSchema} />
  <Breadcrumbs
    bar
    items={[{ text: 'Home', href: '/' }, { text: 'Comparisons', href: '/comparisons/' }, { text: c.title }]}
  />
  <section class="relative mx-auto max-w-4xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2 text-center">Head-to-Head Comparison</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading text-center">
      {c.title}
    </h1>
    <p class="mt-4 max-w-3xl mx-auto text-lg text-muted text-center">{c.summary}</p>
  </section>
  <p class="mx-auto max-w-4xl px-4 sm:px-6 pb-2 text-xs text-muted dark:text-slate-400">
    Maintained by <span class="font-semibold">SmokingCessationHub Tech Team</span> · Not reviewed by a clinician
    {c.lastReviewed && <span> · Last reviewed: {c.lastReviewed}</span>}
  </p>

  <section class="mx-auto max-w-4xl px-4 sm:px-6 py-6">
    <div class="card p-6 md:p-8 bg-primary/5 border-primary/30">
      <h2 class="text-xl font-bold font-heading mb-2">The short answer</h2>
      <p class="text-heading">{c.bottomLine}</p>
    </div>
  </section>

  {
    hasBody && (
      <section class="mx-auto max-w-4xl px-4 sm:px-6 pb-4">
        <div class="prose prose-lg max-w-none dark:prose-invert prose-headings:font-heading prose-headings:font-bold prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:text-heading dark:prose-headings:text-slate-200 prose-a:text-primary dark:prose-a:text-blue-400 prose-table:text-sm prose-th:text-left">
          <Content />
        </div>
      </section>
    )
  }

  {
    !hasBody && (
      <section class="mx-auto max-w-4xl px-4 sm:px-6 py-8 space-y-8">
        <div class="card p-8">
          <h2 class="text-2xl font-bold font-heading mb-3">What the evidence shows</h2>
          <p class="text-muted dark:text-slate-400">{c.whatEvidenceShows}</p>
          <p class="text-sm mt-3">
            Evidence strength: <span class="font-bold text-primary">{c.evidenceStrength}</span>
          </p>
        </div>

        <div class="card p-8">
          <h2 class="text-2xl font-bold font-heading mb-4">Side by side</h2>
          <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
              <thead>
                <tr class="border-b border-gray-200 dark:border-slate-700">
                  <th class="py-3 pr-4 font-bold text-heading dark:text-slate-200">Dimension</th>
                  <th class="py-3 pr-4 font-bold text-heading dark:text-slate-200">{c.optionA}</th>
                  <th class="py-3 font-bold text-heading dark:text-slate-200">{c.optionB}</th>
                </tr>
              </thead>
              <tbody class="text-muted dark:text-slate-400">
                {c.headToHead.map((row) => (
                  <tr class="border-b border-gray-100 dark:border-slate-800 align-top">
                    <td class="py-3 pr-4 font-semibold text-heading dark:text-slate-300">{row.dimension}</td>
                    <td class="py-3 pr-4">{row.optionA}</td>
                    <td class="py-3">{row.optionB}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
          <div class="card p-8">
            <h2 class="text-xl font-bold font-heading mb-2 text-primary">Who might prefer: {c.optionA}</h2>
            <p class="text-muted dark:text-slate-400">{c.whoMightPreferA}</p>
          </div>
          <div class="card p-8">
            <h2 class="text-xl font-bold font-heading mb-2">Who might prefer: {c.optionB}</h2>
            <p class="text-muted dark:text-slate-400">{c.whoMightPreferB}</p>
          </div>
        </div>
      </section>
    )
  }

  <section class="mx-auto max-w-4xl px-4 sm:px-6 py-8 space-y-8">
    <div class="card p-8">
      <h2 class="text-xl font-bold font-heading mb-2">Community experience</h2>
      <p class="text-muted dark:text-slate-400">{c.communityExperience}</p>
      <p class="mt-3 text-xs text-muted dark:text-slate-500">
        Community reports describe individual attempts. They are not evidence of what will work for you.
      </p>
    </div>
  </section>

  <ReviewStatement updated={c.lastReviewed} />
  <Sources sources={pageSources} />
  <CallToAction
    title="Compare another decision"
    subtitle="See all head-to-head comparisons."
    actions={[
      { variant: 'primary', text: 'All Comparisons', href: '/comparisons/' },
      { text: 'All Quit Methods', href: '/methods/' },
    ]}
  />
</Layout>
