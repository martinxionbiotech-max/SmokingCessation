---
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { SITE } from 'astrowind:config';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Quit Smoking Tools | Quit Smoking Hub',
  description:
    'Practical tools for quitting: quit date planning, trigger mapping, craving journal, money saved, and links to quitlines and evidence-based support.',
};

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Quit Smoking Tools | Quit Smoking Hub',
  name: 'Quit Smoking Tools | Quit Smoking Hub',
  description: 'Practical tools for quitting: quit date planning, trigger mapping, craving journal, money saved, and links to quitlines and evidence-based support.',
  url: `${String(SITE.site).replace(/\/$/, '')}/tools/`,
  mainEntityOfPage: `${String(SITE.site).replace(/\/$/, '')}/tools/`,
  isPartOf: { '@id': `${SITE.site}/#website` },
  publisher: { '@id': `${SITE.site}/#organization` },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.site },
    { '@type': 'ListItem', position: 2, name: 'Practical tools for your quit' },
  ],
};
---



<Layout metadata={metadata}>
  <StructuredData slot="head" schema={[pageSchema, breadcrumbSchema]} />
  <Breadcrumbs bar items={[{ text: 'Home', href: '/' }, { text: 'Practical tools for your quit' }]} />
  <section class="relative mx-auto max-w-4xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2 text-center">Quit Tools</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading text-center">
      Practical tools for your quit
    </h1>
    <p class="mt-4 max-w-3xl mx-auto text-lg text-muted text-center">
      Simple, free, paper-and-pen tools. No accounts, no apps required — the evidence supports structured planning
      and tracking, not any particular product.
    </p>
  </section>

  <section class="mx-auto max-w-4xl px-4 sm:px-6 py-8 space-y-8">
    <div class="card p-8">
      <h2 class="text-2xl font-bold font-heading mb-3">1. The quit date planner</h2>
      <p class="text-muted dark:text-slate-400 mb-3">Before your quit date, write down:</p>
      <ul class="list-disc list-inside space-y-2 text-muted dark:text-slate-400">
        <li>My quit date: ______________</li>
        <li>My quit method (see <a href="/methods/" class="text-primary underline decoration-1 underline-offset-2">methods</a>): ______________</li>
        <li>Who I will tell: ______________</li>
        <li>What I will do with cigarettes, lighters, ashtrays: ______________</li>
        <li>My support line: quitline number or community: ______________</li>
      </ul>
    </div>

    <div class="card p-8">
      <h2 class="text-2xl font-bold font-heading mb-3">2. The trigger map</h2>
      <p class="text-muted dark:text-slate-400 mb-3">
        From the <a href="/triggers/" class="text-primary underline decoration-1 underline-offset-2">trigger list</a>,
        pick your top five triggers and plan one replacement for each:
      </p>
      <ul class="list-disc list-inside space-y-2 text-muted dark:text-slate-400">
        <li>Trigger 1: ______ → I will instead: ______</li>
        <li>Trigger 2: ______ → I will instead: ______</li>
        <li>Trigger 3: ______ → I will instead: ______</li>
        <li>Trigger 4: ______ → I will instead: ______</li>
        <li>Trigger 5: ______ → I will instead: ______</li>
      </ul>
    </div>

    <div class="card p-8">
      <h2 class="text-2xl font-bold font-heading mb-3">3. The craving journal</h2>
      <p class="text-muted dark:text-slate-400 mb-3">
        For each strong craving, note four things. After a week you will see your personal patterns:
      </p>
      <ul class="list-disc list-inside space-y-2 text-muted dark:text-slate-400">
        <li>Time and place: ______</li>
        <li>What happened just before: ______</li>
        <li>Intensity (1–10): ______</li>
        <li>What I did, and whether it helped: ______</li>
      </ul>
    </div>

    <div class="card p-8">
      <h2 class="text-2xl font-bold font-heading mb-3">4. The money counter</h2>
      <p class="text-muted dark:text-slate-400">
        Multiply your daily pack cost by your days quit. Most people are surprised at the total after one month —
        many community reports describe saving this money toward something concrete as a strong motivator.
      </p>
    </div>

    <div class="card p-8">
      <h2 class="text-2xl font-bold font-heading mb-3">5. Free professional support</h2>
      <ul class="list-disc list-inside space-y-2 text-muted dark:text-slate-400">
        <li><strong class="text-heading">US:</strong> 1-800-QUIT-NOW (state quitlines)</li>
        <li><strong class="text-heading">UK:</strong> NHS stop smoking services and the national quitline</li>
        <li><strong class="text-heading">Most countries:</strong> a national quitline or free stop-smoking service exists — search "quitline [your country]"</li>
        <li><strong class="text-heading">WHO:</strong> global cessation resources at who.int</li>
      </ul>
    </div>
  </section>

  <CallToAction
    title="Tools are only as good as the plan"
    subtitle="Combine them with a method and support for the strongest start."
    actions={[
      { variant: 'primary', text: 'Compare Quit Methods', href: '/methods/' },
      { text: 'Start Here', href: '/start/' },
    ]}
  />
</Layout>
