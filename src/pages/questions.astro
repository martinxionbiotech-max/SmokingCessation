---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import ReviewStatement from '~/components/common/ReviewStatement.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { SITE } from 'astrowind:config';
import { authorRef, dateFields } from '~/utils/schema';

const questions = (await getCollection('question')).sort((a, b) => a.data.question.localeCompare(b.data.question));
const questionPages = (await getCollection('questionPage')).sort((a, b) =>
  a.data.question.localeCompare(b.data.question)
);
const pageBySlug = new Map(questionPages.map((p) => [p.data.slug, p.data]));

// The hub is an index, not a 112-answer wall. Long answers live on
// /questions/{slug}/; every other question keeps its one-paragraph answer here.
const featured = questionPages.map((p) => p.data);

const stageOrder = [
  'Before Quitting',
  'Quit Date',
  'First 72 Hours',
  'First Week',
  'First Month',
  'Withdrawal',
  'Cravings',
  'Triggers',
  'Medication',
  'Relapse',
  'Mental Health',
  'Weight',
  'Alcohol & Social Situations',
  'Vaping',
  'Pregnancy',
  'Long-Term Recovery',
];

const grouped = stageOrder
  .map((stage) => ({ stage, items: questions.filter((q) => q.data.stage === stage) }))
  .filter((g) => g.items.length > 0);
const ungrouped = questions.filter((q) => !q.data.stage);

const site = String(SITE.site).replace(/\/$/, '');

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  headline: 'Popular Questions About Quitting Smoking',
  name: 'Popular Questions About Quitting Smoking',
  description:
    'Direct answers to the questions people actually ask about quitting smoking: withdrawal, cravings, methods, relapse and health changes.',
  url: `${site}/questions/`,
  mainEntityPage: { '@id': `${site}/#website` },
  isPartOf: { '@id': `${site}/#website` },
  author: authorRef(SITE.site),
  publisher: { '@id': `${site}/#organization` },
};

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'In-depth answers about quitting smoking',
  numberOfItems: featured.length,
  itemListElement: featured.map((q, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: q.question,
    url: `${site}/questions/${q.slug}/`,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site },
    { '@type': 'ListItem', position: 2, name: 'Questions', item: `${site}/questions/` },
  ],
};

const metadata = {
  title: 'Popular Questions About Quitting Smoking',
  description:
    'Direct answers to the questions people actually ask about quitting smoking: withdrawal, cravings, methods, relapse, sleep, weight gain and health changes.',
  canonical: `${site}/questions/`,
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={[pageSchema, listSchema, breadcrumbSchema]} />

  <section class="relative mx-auto max-w-4xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2 text-center">Popular Questions</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading text-center">
      Questions people actually ask
    </h1>
    <p class="mt-4 max-w-3xl mx-auto text-lg text-muted text-center">
      Short, direct answers first — then the detail, the evidence and what remains uncertain. No filler.
    </p>
  </section>

  <section class="mx-auto max-w-4xl px-4 sm:px-6 py-8">
    <h2 class="text-2xl font-bold font-heading mb-2 text-primary">In-depth answers</h2>
    <p class="text-muted dark:text-slate-400 mb-6 text-sm">
      Full pages on the questions that need more than a paragraph: timing, medication decisions, lapses and preparing to
      stop.
    </p>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        featured.map((q) => (
          <a
            href={`/questions/${q.slug}/`}
            class="card p-6 no-underline block hover:border-primary border border-transparent transition-colors"
          >
            <span class="text-xs font-bold uppercase tracking-wide text-secondary">{q.stage}</span>
            <h3 class="mt-1 text-lg font-bold font-heading text-heading">{q.question}</h3>
            <p class="mt-2 text-sm text-muted dark:text-slate-400 line-clamp-3">{q.directAnswer}</p>
            <span class="mt-3 inline-block text-sm font-semibold text-primary">Read the full answer →</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 sm:px-6 pb-8">
    <h2 class="text-2xl font-bold font-heading mb-2 text-primary">Browse all {questions.length} questions</h2>
    <p class="text-muted dark:text-slate-400 mb-6 text-sm">
      Grouped by the stage of quitting they belong to. Questions with a full page are linked; the rest include a short
      answer here.
    </p>
    <div class="space-y-8">
      {
        grouped.map((g) => (
          <div>
            <h3 class="text-xl font-bold font-heading mb-3 text-heading">{g.stage}</h3>
            <div class="space-y-3">
              {g.items.map((q) => {
                const detail = pageBySlug.get(q.data.slug);
                return (
                  <div class="border-b border-gray-200 dark:border-slate-700 pb-3">
                    <p class="font-semibold text-heading">
                      {detail ? (
                        <a href={`/questions/${q.data.slug}/`} class="underline decoration-1 underline-offset-2">
                          {q.data.question}
                        </a>
                      ) : (
                        q.data.question
                      )}
                    </p>
                    <p class="text-sm text-muted dark:text-slate-400 mt-1">{q.data.shortAnswer}</p>
                  </div>
                );
              })}
            </div>
          </div>
        ))
      }
      {
        ungrouped.length > 0 && (
          <div>
            <h3 class="text-xl font-bold font-heading mb-3 text-heading">More questions</h3>
            <div class="space-y-3">
              {ungrouped.map((q) => (
                <div class="border-b border-gray-200 dark:border-slate-700 pb-3">
                  <p class="font-semibold text-heading">{q.data.question}</p>
                  <p class="text-sm text-muted dark:text-slate-400 mt-1">{q.data.shortAnswer}</p>
                </div>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  <CallToAction
    title="Still wondering about something?"
    subtitle="Browse the full knowledge base for deeper answers."
    actions={[
      { variant: 'primary', text: 'Start Here', href: '/start/' },
      { text: 'Research Highlights', href: '/research/' },
    ]}
  />

  <ReviewStatement />
</Layout>
