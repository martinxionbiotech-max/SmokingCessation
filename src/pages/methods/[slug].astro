---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import StructuredData from '~/components/common/StructuredData.astro';

import { SITE } from 'astrowind:config';

export async function getStaticPaths() {
  const methods = await getCollection('method');
  return methods.map((m) => ({ params: { slug: m.data.slug }, props: { method: m } }));
}

const { method } = Astro.props;
const d = method.data;

const url = `${String(SITE.site).replace(/\/$/, '')}/methods/${d.slug}/`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.summary,
  url,
  mainEntityOfPage: url,
  publisher: { '@id': `${SITE.site}/#organization` },
  dateModified: '2026-10-04',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.site },
    { '@type': 'ListItem', position: 2, name: 'Quit Methods', item: SITE.site + '/methods/' },
    { '@type': 'ListItem', position: 3, name: d.title },
  ],
};

const metadata = {
  title: d.title,
  description: d.summary,
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={[articleSchema, breadcrumbSchema]} />
  <Breadcrumbs bar items={[{ text: 'Home', href: '/' }, { text: 'Methods', href: '/methods/' }, { text: d.title }]} />

  <section class="relative mx-auto max-w-4xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2 text-center">{d.category}</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading text-center">
      {d.title}
    </h1>
    <p class="mt-4 max-w-3xl mx-auto text-lg text-muted text-center">{d.summary}</p>
  </section>

  <section class="mx-auto max-w-4xl px-4 sm:px-6 py-8 space-y-10">
    <div>
      <h2 class="text-2xl font-bold font-heading mb-3">What it is</h2>
      <p class="text-muted dark:text-slate-400">{d.whatItIs}</p>
    </div>

    <div>
      <h2 class="text-2xl font-bold font-heading mb-3">How it works</h2>
      <p class="text-muted dark:text-slate-400">{d.howItWorks}</p>
    </div>

    <div class="card p-6">
      <h2 class="text-xl font-bold font-heading mb-2">Evidence</h2>
      <p class="text-muted dark:text-slate-400 text-sm mb-2">{d.evidence}</p>
      <p class="text-sm">
        Evidence strength: <span class="font-bold text-primary">{d.evidenceStrength}</span>
      </p>
    </div>

    <div>
      <h2 class="text-2xl font-bold font-heading mb-3">Reported community experiences</h2>
      <p class="text-muted dark:text-slate-400">{d.reportedCommunityExperiences}</p>
    </div>

    <div>
      <h2 class="text-2xl font-bold font-heading mb-3">Practical considerations</h2>
      <ul class="list-disc list-inside space-y-2 text-muted dark:text-slate-400">
        {d.practicalConsiderations.map((c) => <li>{c}</li>)}
      </ul>
    </div>

    <div class="card p-6">
      <h2 class="text-xl font-bold font-heading mb-2">Limitations</h2>
      <p class="text-muted dark:text-slate-400 text-sm">{d.limitations}</p>
    </div>

    {
      d.medicationWarning && (
        <p class="text-sm font-bold text-heading">
          This method involves a medication. This page provides information only — it is not a prescription, dosing
          advice or a substitute for professional medical judgment. See the{' '}
          <a href={`/medications/${d.slug}/`} class="text-primary underline decoration-1 underline-offset-2">
            medication evidence page
          </a>{' '}
          and talk to a healthcare professional.
        </p>
      )
    }

    <p class="text-sm text-muted dark:text-slate-500">
      Community-reported experiences are de-identified individual accounts and do not constitute scientific evidence
      or medical advice.
    </p>
  </section>
</Layout>
