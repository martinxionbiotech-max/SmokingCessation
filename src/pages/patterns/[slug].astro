---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import StructuredData from '~/components/common/StructuredData.astro';

import { SITE } from 'astrowind:config';

export async function getStaticPaths() {
  const patterns = await getCollection('pattern');
  return patterns.map((p) => ({ params: { slug: p.data.slug }, props: { pattern: p } }));
}

const { pattern } = Astro.props;
const d = pattern.data;

const url = `${String(SITE.site).replace(/\/$/, '')}/patterns/${d.slug}/`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.observedPattern,
  url,
  mainEntityOfPage: url,
  publisher: { '@id': `${SITE.site}/#organization` },
  dateModified: '2026-10-04',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.site },
    { '@type': 'ListItem', position: 2, name: 'Community Patterns', item: SITE.site + '/patterns/' },
    { '@type': 'ListItem', position: 3, name: d.title },
  ],
};

const metadata = {
  title: d.title,
  description: d.observedPattern,
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={[articleSchema, breadcrumbSchema]} />
  <Breadcrumbs bar items={[{ text: 'Home', href: '/' }, { text: 'Patterns', href: '/patterns/' }, { text: d.title }]} />

  <section class="relative mx-auto max-w-4xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2 text-center">Community Pattern</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading text-center">
      {d.title}
    </h1>
  </section>

  <section class="mx-auto max-w-4xl px-4 sm:px-6 py-8 space-y-8">
    <div class="card p-8">
      <h2 class="text-2xl font-bold font-heading mb-3">Observed pattern</h2>
      <p class="text-muted dark:text-slate-400">{d.observedPattern}</p>
      <p class="text-sm text-muted dark:text-slate-500 mt-3">
        Relevant experiences: <strong class="text-heading">{d.numberOfRelevantExperiences}</strong>
      </p>
    </div>

    {
      d.commonContexts?.length > 0 && (
        <div>
          <h2 class="text-2xl font-bold font-heading mb-3">Common contexts</h2>
          <ul class="list-disc list-inside space-y-2 text-muted dark:text-slate-400">
            {d.commonContexts.map((c) => <li>{c}</li>)}
          </ul>
        </div>
      )
    }

    {
      d.reportedStrategies?.length > 0 && (
        <div>
          <h2 class="text-2xl font-bold font-heading mb-3">Reported strategies</h2>
          <ul class="list-disc list-inside space-y-2 text-muted dark:text-slate-400">
            {d.reportedStrategies.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      )
    }

    {
      d.contradictoryExperiences && (
        <div>
          <h2 class="text-2xl font-bold font-heading mb-3">Contradictory experiences</h2>
          <p class="text-muted dark:text-slate-400">{d.contradictoryExperiences}</p>
        </div>
      )
    }

    <div>
      <h2 class="text-2xl font-bold font-heading mb-3">Scientific evidence</h2>
      <p class="text-muted dark:text-slate-400">{d.scientificEvidence}</p>
    </div>

    <div>
      <h2 class="text-2xl font-bold font-heading mb-3">Possible explanations</h2>
      <p class="text-muted dark:text-slate-400">{d.possibleExplanations}</p>
    </div>

    <div class="card p-6">
      <h2 class="text-xl font-bold font-heading mb-2">What we do not know</h2>
      <p class="text-muted dark:text-slate-400 text-sm">{d.whatWeDoNotKnow}</p>
    </div>

    <div>
      <h2 class="text-2xl font-bold font-heading mb-3">Practical takeaways</h2>
      <ul class="list-disc list-inside space-y-2 text-muted dark:text-slate-400">
        {d.practicalTakeaways.map((t) => <li>{t}</li>)}
      </ul>
    </div>

    <p class="text-sm text-muted dark:text-slate-500">
      A community pattern is an observation across multiple de-identified reports. It is not a medical conclusion
      and not scientific evidence on its own.
    </p>
  </section>
</Layout>
