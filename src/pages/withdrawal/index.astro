---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import Sources from '~/components/common/Sources.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import ReviewStatement from '~/components/common/ReviewStatement.astro';
import { SITE } from 'astrowind:config';
import { authorRef, dateFields } from '~/utils/schema';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Image from '~/components/common/Image.astro';

const symptoms = (await getCollection('withdrawal')).sort((a, b) => a.data.slug.localeCompare(b.data.slug));

const metadata = {
  title: 'Nicotine Withdrawal | Quit Smoking Hub',
  description:
    'What nicotine withdrawal feels like, how long it lasts, and what actually helps: cravings, irritability, sleep problems, concentration, appetite, mood and cough.',
};

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  headline: 'Nicotine Withdrawal | Quit Smoking Hub',
  name: 'Nicotine Withdrawal | Quit Smoking Hub',
  description: 'What nicotine withdrawal feels like, how long it lasts, and what actually helps: cravings, irritability, sleep problems, concentration, appetite, mood and cough.',
  url: `${String(SITE.site).replace(/\/$/, '')}/withdrawal/`,
  mainEntityOfPage: `${String(SITE.site).replace(/\/$/, '')}/withdrawal/`,
  isPartOf: { '@id': `${SITE.site}/#website` },
  author: authorRef(SITE.site),
  publisher: { '@id': `${SITE.site}/#organization` },
  ...dateFields(),
};

const pageSources = [
    { label: 'WHO — Tobacco fact sheet', url: 'https://www.who.int/news-room/fact-sheets/detail/tobacco' },
    { label: 'CDC — Smoking and Tobacco Use', url: 'https://www.cdc.gov/tobacco/index.html' },
];

---



<Layout metadata={metadata}>
  <StructuredData slot="head" schema={[pageSchema]} />
  <Breadcrumbs bar items={[{ text: 'Home', href: '/' }, { text: 'Withdrawal', href: '/withdrawal/' }, { text: 'What nicotine withdrawal feels like' }]} />
  <section class="relative mx-auto max-w-4xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2 text-center">Nicotine Withdrawal</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading text-center">
      What nicotine withdrawal feels like
    </h1>
    <p class="mt-4 max-w-3xl mx-auto text-lg text-muted text-center">
      Withdrawal is your body and brain adjusting to life without nicotine. It is uncomfortable but temporary — and
      it is the main reason quitting feels hard in the first weeks.
    </p>
  </section>
  <p class="mx-auto max-w-4xl px-4 sm:px-6 pb-2 text-xs text-muted dark:text-slate-400">Maintained by <span class="font-semibold">SmokingCessationHub Tech Team</span></p>

  <div class="mx-auto max-w-4xl px-4 sm:px-6">
    <Image
      src="~/assets/images/qs-withdrawal-calm.webp"
      alt="A peaceful windowsill with herbal tea, an open journal and a small green plant in soft morning light"
      class="rounded-md w-full"
      width={1024}
      height={576}
    />
  </div>

  <section class="mx-auto max-w-4xl px-4 sm:px-6 py-6">
    <a
      href="/withdrawal/timeline/"
      class="card flex flex-col gap-1 p-6 no-underline hover:-translate-y-1 transition duration-200 border-l-4 border-l-primary"
    >
      <span class="font-bold font-heading text-xl text-heading dark:text-slate-200">
        The withdrawal timeline, hour by hour and week by week
      </span>
      <span class="text-muted dark:text-slate-400 text-sm">
        When cravings peak, how long each symptom usually lasts, what helps at each stage, and which signs are not
        withdrawal at all.
      </span>
    </a>
  </section>

  <section class="mx-auto max-w-4xl px-4 sm:px-6 py-8">
    <div class="grid gap-6 md:grid-cols-2">
      {
        symptoms.map((s) => (
          <a
            href={`/withdrawal/${s.data.slug}/`}
            class="card p-6 no-underline hover:-translate-y-1 transition duration-200"
          >
            <h2 class="font-bold font-heading text-xl mb-2">{s.data.title.replace('Withdrawal: ', '')}</h2>
            <p class="text-muted dark:text-slate-400 text-sm">{s.data.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 sm:px-6 py-8">
    <div class="space-y-6">
      <div>
        <h2 class="text-2xl font-bold font-heading mb-3">How long does withdrawal last?</h2>
        <p class="text-muted dark:text-slate-400">
          Symptoms usually begin within hours of the last cigarette, peak in the first 3–7 days, and mostly resolve
          within 2–4 weeks. Cravings can persist longer but become less frequent and less intense. The
          <a href="/withdrawal/timeline/" class="text-primary underline decoration-1 underline-offset-2">
            hour-by-hour, week-by-week withdrawal timeline
          </a>
          walks through each stage, and the full{' '}
          <a href="/timeline/" class="text-primary underline decoration-1 underline-offset-2">quit timeline</a>
          covers what changes in the body.
        </p>
      </div>
      <div>
        <h2 class="text-2xl font-bold font-heading mb-3">Two sources of information — kept separate</h2>
        <p class="text-muted dark:text-slate-400">
          Every symptom page separates <strong class="text-heading">what science says</strong> (documented symptoms,
          time course, effective approaches) from <strong class="text-heading">what people report</strong> (community
          experiences, which vary and are not predictions). A community member reporting something on day 7 does not
          mean it will happen to you on day 7.
        </p>
        <p class="mt-3 text-muted dark:text-slate-400">
          For the underlying science — mechanism, timing evidence, what varies and what research documents for each
          symptom — see the{' '}
          <a
            href="https://data.smokingcessationhub.com/withdrawal/"
            target="_blank"
            class="text-primary underline decoration-1 underline-offset-2"
          >
            Withdrawal section of the Data Center
          </a>.
        </p>
      </div>
      <div>
        <h2 class="text-2xl font-bold font-heading mb-3">When withdrawal needs medical attention</h2>
        <p class="text-muted dark:text-slate-400">
          Withdrawal itself is uncomfortable but not dangerous. But if symptoms are severe, last far beyond a month,
          or involve persistent low mood or thoughts of self-harm, talk to a healthcare professional — quitting does
          not mean coping alone.
        </p>
      </div>
    </div>
  </section>

  <Sources sources={pageSources} />
  <CallToAction
    title="Feeling it right now?"
    subtitle="Read how people manage this exact moment — and what the evidence supports."
    actions={[
      { variant: 'primary', text: 'Cravings Playbook', href: '/cravings/' },
      { text: 'View the Timeline', href: '/timeline/' },
    ]}
  />

  <ReviewStatement />
</Layout>
