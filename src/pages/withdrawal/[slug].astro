---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import StructuredData from '~/components/common/StructuredData.astro';

import { SITE } from 'astrowind:config';

export async function getStaticPaths() {
  const symptoms = await getCollection('withdrawal');
  return symptoms.map((s) => ({ params: { slug: s.data.slug }, props: { symptom: s } }));
}

const { symptom } = Astro.props;
const d = symptom.data;

const url = `${String(SITE.site).replace(/\/$/, '')}/withdrawal/${d.slug}/`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.summary,
  url,
  mainEntityOfPage: url,
  publisher: { '@id': `${SITE.site}/#organization` },
  dateModified: '2026-10-04',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.site },
    { '@type': 'ListItem', position: 2, name: 'Nicotine Withdrawal', item: SITE.site + '/withdrawal/' },
    { '@type': 'ListItem', position: 3, name: d.title.replace('Withdrawal: ', '') },
  ],
};

const metadata = {
  title: d.title,
  description: d.summary,
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={[articleSchema, breadcrumbSchema]} />
  <Breadcrumbs bar items={[{ text: 'Home', href: '/' }, { text: 'Withdrawal', href: '/withdrawal/' }, { text: d.title.replace('Withdrawal: ', '') }]} />

  <section class="relative mx-auto max-w-4xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2 text-center">Nicotine Withdrawal</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading text-center">
      {d.title}
    </h1>
    <p class="mt-4 max-w-3xl mx-auto text-lg text-muted text-center">{d.summary}</p>
  </section>

  <section class="mx-auto max-w-4xl px-4 sm:px-6 py-8 space-y-10">
    <div>
      <h2 class="text-2xl font-bold font-heading mb-3">What science says</h2>
      <p class="text-muted dark:text-slate-400">{d.whatScienceSays}</p>
    </div>

    <div>
      <h2 class="text-2xl font-bold font-heading mb-3">What people report</h2>
      <p class="text-muted dark:text-slate-400">{d.whatPeopleReport}</p>
    </div>

    <div class="card p-6">
      <h2 class="text-xl font-bold font-heading mb-2">Typical uncertainty</h2>
      <p class="text-muted dark:text-slate-400 text-sm">{d.typicalUncertainty}</p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <div>
        <h2 class="text-xl font-bold font-heading mb-3">How people manage it</h2>
        <ul class="list-disc list-inside space-y-2 text-muted dark:text-slate-400">
          {d.howPeopleManage.map((x) => <li>{x}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="text-xl font-bold font-heading mb-3">Evidence-supported approaches</h2>
        <ul class="list-disc list-inside space-y-2 text-muted dark:text-slate-400">
          {d.evidenceSupportedApproaches.map((x) => <li>{x}</li>)}
        </ul>
      </div>
    </div>

    <div class="card p-6 border-l-4 border-l-primary">
      <h2 class="text-xl font-bold font-heading mb-2">When to seek medical advice</h2>
      <p class="text-muted dark:text-slate-400 text-sm">{d.whenToSeekMedicalAdvice}</p>
    </div>

    {
      d.evidenceSources && (
        <div class="card p-6">
          <h2 class="text-xl font-bold font-heading mb-2">Evidence sources</h2>
          <p class="text-muted dark:text-slate-400 text-sm">{d.evidenceSources} Full records in the{' '}
            <a href="https://data.smokingcessationhub.com/research/" target="_blank" class="underline decoration-1 underline-offset-2">Data Center research database</a>.
          </p>
        </div>
      )
    }

    <p class="text-sm text-muted dark:text-slate-500">
      This page combines documented withdrawal science with community-reported experience. Community reports are
      de-identified individual accounts, not scientific evidence and not predictions. This page is not medical advice.
    </p>
  </section>
</Layout>
