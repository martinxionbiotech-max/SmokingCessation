---
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import StructuredData from '~/components/common/StructuredData.astro';

import { SITE } from 'astrowind:config';

export async function getStaticPaths() {
  const triggers = await getCollection('triggers');
  return triggers.map((t) => ({ params: { slug: t.data.slug }, props: { trigger: t } }));
}

const { trigger } = Astro.props;
const d = trigger.data;

const url = `${String(SITE.site).replace(/\/$/, '')}/triggers/${d.slug}/`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.summary,
  url,
  mainEntityOfPage: url,
  publisher: { '@id': `${SITE.site}/#organization` },
  dateModified: '2026-10-04',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.site },
    { '@type': 'ListItem', position: 2, name: 'Smoking Triggers', item: SITE.site + '/triggers/' },
    { '@type': 'ListItem', position: 3, name: d.title },
  ],
};

const metadata = {
  title: d.title,
  description: d.summary,
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={[articleSchema, breadcrumbSchema]} />
  <Breadcrumbs bar items={[{ text: 'Home', href: '/' }, { text: 'Triggers', href: '/triggers/' }, { text: d.title }]} />

  <section class="relative mx-auto max-w-4xl px-4 sm:px-6 pt-8 md:pt-12 pb-4">
    <p class="text-base font-bold tracking-wide uppercase text-secondary mb-2 text-center">Smoking Trigger</p>
    <h1 class="text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading text-heading text-center">
      {d.title}
    </h1>
    <p class="mt-4 max-w-3xl mx-auto text-lg text-muted text-center">{d.summary}</p>
  </section>

  <section class="mx-auto max-w-4xl px-4 sm:px-6 py-8 space-y-10">
    <div>
      <h2 class="text-2xl font-bold font-heading mb-3">Definition</h2>
      <p class="text-muted dark:text-slate-400">{d.definition}</p>
    </div>

    <div>
      <h2 class="text-2xl font-bold font-heading mb-3">Community reports</h2>
      <p class="text-muted dark:text-slate-400">{d.communityReports}</p>
      {
        d.reportedContexts?.length > 0 && (
          <ul class="list-disc list-inside mt-3 space-y-1 text-muted dark:text-slate-400">
            {d.reportedContexts.map((c) => <li>{c}</li>)}
          </ul>
        )
      }
    </div>

    <div>
      <h2 class="text-2xl font-bold font-heading mb-3">Scientific evidence</h2>
      <p class="text-muted dark:text-slate-400">{d.scientificEvidence}</p>
      <p class="mt-3 text-sm">
        Evidence strength:{' '}
        <span class="font-bold text-primary">{d.evidenceStrength}</span>
      </p>
    </div>

    <div>
      <h2 class="text-2xl font-bold font-heading mb-3">Practical strategies</h2>
      <ul class="list-disc list-inside space-y-2 text-muted dark:text-slate-400">
        {d.practicalStrategies.map((s) => <li>{s}</li>)}
      </ul>
    </div>

    <div class="card p-6">
      <h2 class="text-xl font-bold font-heading mb-2">Limitations</h2>
      <p class="text-muted dark:text-slate-400 text-sm">{d.limitations}</p>
    </div>

    <p class="text-sm text-muted dark:text-slate-500">
      This page summarizes community-reported patterns alongside scientific evidence. Community reports are
      de-identified individual accounts and do not constitute scientific evidence or medical advice.
    </p>
  </section>
</Layout>
