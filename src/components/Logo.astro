---
import { SITE } from 'astrowind:config';
---

<span class="flex items-center gap-1.5 self-center whitespace-nowrap">
  <span
    class="inline-flex h-7 w-7 items-center justify-center rounded-sm bg-primary text-sm font-bold text-black dark:text-black"
  >
    Q
  </span>
  <span class="text-lg md:text-base font-bold tracking-tight text-gray-900 dark:text-white leading-none">
    {SITE?.name}{' '}
    <span class="block text-[9px] font-medium uppercase tracking-[0.18em] text-primary dark:text-secondary mt-0.5">
      Knowledge &amp; Experience
    </span>
  </span>
</span>
